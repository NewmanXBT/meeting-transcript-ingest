[Unit]
Description=ZeroDrift meeting transcript ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zerodrift
Group=zerodrift
WorkingDirectory=/opt/meeting-transcript-ingest
EnvironmentFile=/etc/zerodrift-meetings/env
Environment=HOME=/var/lib/zerodrift-meetings
Environment=XDG_CONFIG_HOME=/var/lib/zerodrift-meetings/.config
Environment=XDG_DATA_HOME=/var/lib/zerodrift-meetings/.local/share
Environment=AWS_PAGER=
ExecStart=/usr/bin/python3 /opt/meeting-transcript-ingest/scripts/meeting_ingest.py daemon-run --once --state-path /var/lib/zerodrift-meetings/daemon-state.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/zerodrift-meetings /var/lib/zerodrift-publisher/ObsidianVault
