[Unit]
Description=ZeroDrift meeting transcript ingest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=zerodrift
Group=zerodrift
WorkingDirectory=/opt/meeting-transcript-ingest
EnvironmentFile=/etc/zerodrift-meetings/env
Environment=HOME=/var/lib/zerodrift-meetings
Environment=AWS_PAGER=
ExecStart=/usr/bin/python3 /opt/meeting-transcript-ingest/scripts/meeting_ingest.py --env-file /etc/zerodrift-meetings/env daemon-run --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/zerodrift-meetings /var/lib/zerodrift-publisher/ObsidianVault
